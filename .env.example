DB_PASSWORD=change-me-strong-db-password

API_INTERNAL_SECRET=change-me-to-a-long-random-string
REPORTMATE_PASSPHRASE=change-me-to-a-long-random-string
NEXTAUTH_SECRET=change-me-to-a-long-random-string

REPORTMATE_TAG=latest

# true: sign-in bypassed, settings read-only. false: Entra ID sign-in (see README).
# Read when the web container starts; apply a change with `docker compose up -d`.
DEMO_MODE=true

PUBLIC_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
